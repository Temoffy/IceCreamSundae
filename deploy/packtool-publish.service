[Unit]
Description=Packtool Publish
After=network.target

[Service]
Type=oneshot
User=agent
WorkingDirectory=/home/agent/IceCreamSundae2
ExecStart=/home/agent/IceCreamSundae2/.venv/bin/python source/cli.py --publish
Environment=MODRINTH_TOKEN=%E
Environment=GITHUB_TOKEN=%GH
Environment=NTFY_TOPIC=%NT
EnvironmentFile=-/home/agent/IceCreamSundae2/.env
